{
  "name": "react-amps-webworker",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter @amps-ui/trading-ui dev",
    "build": "bun run --filter @amps-ui/trading-ui build",
    "preview": "bun run --filter @amps-ui/trading-ui preview",
    "typecheck": "tsc --build",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.4.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "7.3.6"
  }
}
